Xno<-Xn[,c(1,2,4,5,6)]
fit_SRRM<-ame(Y, Xd=Xd, Xr=Xno, Xc=Xno, family="bin")
summary(fit_SRRM)
# Calculate outdegrees and indegrees
outdegrees <- rowSums(Y, na.rm = TRUE)
indegrees <- colSums(Y, na.rm = TRUE)
# Extract row effects and column effects
row_effects <- fit_SRM$APM
col_effects <- fit_SRM$BPM
par(mfrow = c(1, 2))
# Plot estimated row effects vs outdegrees
plot(outdegrees, row_effects,
xlab = "Outdegree", ylab = "Additive Row Effects",
main = "Row Effects vs Outdegrees")
# Plot estimated column effects vs indegrees
plot(indegrees, col_effects,
xlab = "Indegree", ylab = "Additive Column Effects",
main = "Column Effects vs Indegrees")
# Calculate outdegrees and indegrees
outdegrees <- rowSums(Y, na.rm = TRUE)
indegrees <- colSums(Y, na.rm = TRUE)
# Extract row effects and column effects
row_effects <- fit_SRM$APM
col_effects <- fit_SRM$BPM
par(mfrow = c(1, 2))
# Plot estimated row effects vs outdegrees
plot(outdegrees, row_effects,
xlab = "outdegree", ylab = "additive row effects")
# Plot estimated column effects vs indegrees
plot(indegrees, col_effects,
xlab = "indegree", ylab = "additive row effects")
fit_AME<-ame(Y, Xd=Xd[,,2], R=3, family="bin")
U<-fit_AME$U
V<-fit_AME$V
round(cor(U, Xno),2)
# Prepare your nodal characteristics data
# Assume 'nodes_df' is a dataframe with 'status' and 'office' for each node
nodes_df <- data.frame(
status = factor(Xn[,"status"]),  # Replace with actual data
office = factor(Xn[,"office"])   # Replace with actual data
)
# Define colors and symbols for different groups
color_map <- c("Boston" = "green", "Hartford" = "blue", "Providence" = "light blue")
symbol_map <- c("partner" = 1, "associate" = 16)  # 1 is an empty circle, 16 is a filled circle
par(mfrow = c(1, 3))
plot(U[,1], V[,1], xlab = expression(u[1]), ylab = expression(u[1]))
for(i in 1:nrow(nodes_df)) {
points(U[i,1], V[i,2],
pch = symbol_map[nodes_df$status[i]],
col = color_map[nodes_df$office[i]])
}
plot(U[,2], V[,2], xlab = expression(u[2]), ylab = expression(u[2]))
for(i in 1:nrow(nodes_df)) {
points(U[i,1], V[i,2],
pch = symbol_map[nodes_df$status[i]],
col = color_map[nodes_df$office[i]])
}
plot(U[,3], V[,3], xlab = expression(u[3]), ylab = expression(u[3]))
for(i in 1:nrow(nodes_df)) {
points(U[i,1], V[i,2],
pch = symbol_map[nodes_df$status[i]],
col = color_map[nodes_df$office[i]])
}
round(cor(V, Xno),2)
library(ggplot2)
library(gridExtra)
install.packages('gridExtra')
library(ggplot2)
library(gridExtra)
# Assume 'nodes_df' is a dataframe with 'status' and 'office' for each node
nodes_df <- data.frame(
status = factor(Xn[,"status"]),
office = factor(Xn[,"office"])
)
levels(nodes_df$status) <- c("partner", "associate")
levels(nodes_df$office) <- c("Boston", "Hartford", "Providence")
# Define colors and symbols for different groups
color_map <- c("Boston" = "green", "Hartford" = "blue", "Providence" = "lightblue")
shape_map <- c("partner" = 21, "associate" = 19)
p <- ggplot() +
theme_bw() +
theme(panel.spacing = unit(2, "lines"))  # Adjust spacing between panels
plots <- list(
ggplot(nodes_df, aes(x=U[,1], y=V[,1], color=office, shape=status)) +
geom_point() +
xlab(expression(u[1])) +
ylab(expression(v[1])) +
scale_color_manual(values = color_map) +
scale_shape_manual(values = shape_map),
ggplot(nodes_df, aes(x=U[,2], y=V[,2], color=office, shape=status)) +
geom_point() +
xlab(expression(u[2])) +
ylab(expression(v[2])) +
scale_color_manual(values = color_map) +
scale_shape_manual(values = shape_map),
ggplot(nodes_df, aes(x=U[,3], y=V[,3], color=office, shape=status)) +
geom_point() +
xlab(expression(u[3])) +
ylab(expression(v[3])) +
scale_color_manual(values = color_map) +
scale_shape_manual(values = shape_map)
)
do.call(grid.arrange, c(plots, nrow = 2, ncol=2))
netplot(lazegalaw$Y[,,2],ncol=Xn[,3])
